{
  "name": "@xahau/hooks-cli",
  "version": "2.1.0",
  "description": "Hooks CLI is a tool for compiling hooks to Xahau's smart contract format",
  "keywords": [
    "xahau",
    "hooks",
    "smart contract"
  ],
  "main": "dist/npm/src/index.js",
  "types": "dist/npm/src/index.d.ts",
  "files": [
    "dist/**/*",
    "src"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "hooks-cli": "./bin/cli.js",
    "c2wasm-cli": "./bin/c2wasm-cli.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/init dist/npm/src",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "lint": "biome check",
    "format": "biome check --write",
    "headers:update": "node scripts/update-headers.mjs",
    "headers:check": "node scripts/update-headers.mjs --check"
  },
  "author": {
    "name": "Denis Angell",
    "url": "https://github.com/Xahau/hooks-cli"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/Xahau/hooks-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Xahau/hooks-cli/issues"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.3.4",
    "commander": "^10.0.1",
    "dotenv": "^16.1.4",
    "hooks-compiler": "0.2.0",
    "reconnecting-websocket": "^4.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.7"
}
